DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/cyberstudy
# Generate a random secret in ignored backend/.env; never use this placeholder.
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# false only for local HTTP development; use true with production HTTPS.
AUTH_COOKIE_SECURE=false
# Use none with Secure=true only when the HTTPS frontend and API are on different sites.
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_MINUTES=30
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
